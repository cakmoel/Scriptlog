# e2e/.env.example - copy to e2e/.env (gitignored) for local Playwright runs.
# NEVER commit real passwords. These accounts exist ONLY in the ephemeral local
# blogware_e2e database and the throwaway CI MariaDB service container. They
# must never match production credentials (see README "simple, private, secure").
#
#   cp e2e/.env.example e2e/.env   # then fill in local-only test values
#
# On CI the suite works with NO secrets file: unresolved E2E_*_PASS values fall
# back to a per-run random ephemeral password that seedGdprFixtures() hashes
# into the test DB before login. Set the vars below only to pin deterministic
# values (e.g. via GitHub Secrets in .github/workflows/playwright.yml).

# App under test (php -S 127.0.0.1:8099 e2e/router.php)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:8099

# Test-only logins (synthetic @e2e.local mailboxes, not real PII)
E2E_ADMIN_USER=administrator
E2E_ADMIN_PASS=change-me-local-only
E2E_GDPR_USER=gdpr_user
E2E_GDPR_EMAIL=gdpr.test@e2e.local
E2E_GDPR_PASS=change-me-local-only
E2E_NOACCESS_USER=noaccess_user
E2E_NOACCESS_EMAIL=noaccess@e2e.local
E2E_NOACCESS_PASS=change-me-local-only

# Ephemeral test database (throwaway container / local schema)
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=3306
E2E_DB_USER=blogwareuser
E2E_DB_PASS=change-me-local-only
E2E_DB_NAME=blogware_e2e

# Fixture content password for seeded protected post 12 (not an account)
E2E_PROTECTED_POST_PASSWORD=e2e-secret
# Ephemeral remediation API key (generated per run when unset)
E2E_REMEDIATION_API_KEY=
# Test-only app key for the e2e server (never production)
E2E_APP_KEY=
