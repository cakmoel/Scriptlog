# --- Secrets and local configuration ---
.env
.env.*
!.env.example
/config.php
/config.local.php
*.local.php

# Root Apache config ships with production deny rules. The installer may
# regenerate it, but the committed copy is the deployment default and is
# asserted by the e2e security suite. Nested .htaccess files are checked-in
# security controls and must stay tracked.
/nginx-rewrites.conf

# --- Dependencies ---
/vendor/
/lib/vendor/
/vendor-bin/
/node_modules/
composer.phar

# --- Runtime data and caches ---
/storage/
/lib/utility/.lts/
sess_*

# Public page cache and rate-limit data
/public/cache/*
!/public/cache/.htaccess
!/public/cache/index.php
!/public/cache/rate_limit/
/public/cache/rate_limit/*
!/public/cache/rate_limit/.htaccess

# Application logs
/public/log/*
!/public/log/.htaccess
!/public/log/index.php
!/public/log/unlock_attempts/
/public/log/unlock_attempts/*
!/public/log/unlock_attempts/.htaccess

# File caches (translations are pre-seeded; new entries are runtime data)
/public/files/cache/*
!/public/files/cache/index.html
!/public/files/cache/dotenv/
/public/files/cache/dotenv/*
!/public/files/cache/dotenv/.htaccess
!/public/files/cache/htmlpurifier/
/public/files/cache/htmlpurifier/*
!/public/files/cache/htmlpurifier/.htaccess
!/public/files/cache/sanitize/
/public/files/cache/sanitize/*
!/public/files/cache/sanitize/.htaccess
!/public/files/cache/scheduled/
/public/files/cache/scheduled/*
!/public/files/cache/scheduled/.htaccess
!/public/files/cache/sessions/
/public/files/cache/sessions/*
!/public/files/cache/sessions/.htaccess
!/public/files/cache/sessions/index.html
!/public/files/cache/translations/
/public/files/cache/translations/*
!/public/files/cache/translations/.htaccess

# User uploads: keep directory guards and the shipped default images only.
/public/files/audio/*
!/public/files/audio/.htaccess
!/public/files/audio/index.php
/public/files/docs/*
!/public/files/docs/.htaccess
!/public/files/docs/index.php
/public/files/pictures/*
!/public/files/pictures/.htaccess
!/public/files/pictures/index.php
!/public/files/pictures/nophoto.jpg
!/public/files/pictures/scriptlog-1200x630.jpg
!/public/files/pictures/scriptlog-612x221.jpg
/public/files/video/*
!/public/files/video/.htaccess
!/public/files/video/index.php

# HTMLPurifier's generated serializer cache
/lib/core/HTMLPurifier/DefinitionCache/Serializer/URI/

# --- Build and test output ---
/build/
/metrics/
/coverage/
/.phpunit.result.cache
/.phpunit.cache/
/.php-cs-fixer.cache
/.phpstan.cache
/.phpcs.cache
/psalm-cache/
/*.cache

# --- Playwright ---
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Load-testing output (may contain infrastructure details)
/siege-results/

# --- Editors and operating systems ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*~

# --- Node / Python ---
node_modules/
.eslintcache
__pycache__/
venv/
.venv/
_data/

# --- Local experiments and scratch files ---
experiment/
legacy/
/Todo/
.aider.*
check-headers.php

# OpenCode agent definitions are part of the project; only local dependencies
# and caches inside .opencode are ignored (see .opencode/.gitignore).
.opencode/node_modules/
.opencode/.cache/
